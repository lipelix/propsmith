{
  "name": "propsmith",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p site",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run catalog:check",
    "catalog": "tsx tools/catalog.ts",
    "build": "tsx tools/build.ts",
    "textures": "tsx tools/textures.ts",
    "catalog:check": "tsx tools/check.ts",
    "new": "tsx tools/new.ts",
    "bake": "tsx tools/bake.ts",
    "bake:look": "tsx tools/look.ts",
    "site:data": "tsx tools/site-data.ts",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "tsc --noEmit -p site && vite build --config site/vite.config.ts",
    "site:publish": "tsc --noEmit -p site && vite build --config site/vite.config.ts --mode publish",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "three": "^0.183.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/model-viewer": "^4.4.0",
    "@playwright/test": "1.63",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.183.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
