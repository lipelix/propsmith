# Copy to env.auto.tfvars (gitignored) and fill in, then: tofu login && tofu init && tofu apply
cloudflare_api_token  = "CLOUDFLARE_API_TOKEN"  // https://dash.cloudflare.com/profile/api-tokens — personal account: Account Cloudflare Pages Edit + Account Account Settings Edit (Web Analytics)
cloudflare_account_id = "CLOUDFLARE_ACCOUNT_ID" // personal account id (32 hex)
pages_deploy_token    = "PAGES_DEPLOY_TOKEN"    // same page — Account Cloudflare Pages Edit only; becomes the repo secret for CI
github_token          = "GITHUB_TOKEN"          // https://github.com/settings/personal-access-tokens — lipelix/propsmith only: Secrets + Variables read/write
